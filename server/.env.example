# Server Environment Variables (for Vercel)
# These MUST be set in the Vercel project settings for the Server deployment

# Stripe Secret Key (server-side, starts with sk_)
STRIPE_SECRET_KEY=

# Supabase credentials
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_KEY=

# Comma-separated list of allowed origins for CORS
# Set to your deployed client URL(s), comma-separated for multiple domains
# e.g.: https://your-client-project.vercel.app,https://your-client-git-main.vercel.app
# Use * to allow any origin (not recommended for production)
CORS_ORIGIN=