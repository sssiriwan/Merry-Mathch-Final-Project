# Client Environment Variables (for Vercel)
# These MUST be set in the Vercel project settings for the Client deployment

# URL of the deployed Server API (set to your Vercel server URL)
# For example: https://your-server-project.vercel.app
VITE_API_URL=

# Supabase credentials
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe Publishable Key (client-side, starts with pk_)
VITE_STRIPE_PUBLISHABLE_KEY=